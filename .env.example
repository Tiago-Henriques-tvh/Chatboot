# Documents (raw knowledge files) — HOST path bind-mounted into the container.
# This is the ONE thing that can live on your big external drive (exFAT/NTFS is
# fine for reading files). Point it at a folder on /mnt/storage if you like.
DOCS_HOST_PATH=/mnt/storage/chatbot/data

# Qdrant vector database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=training_knowledge

# Ollama LLM (host service reachable from inside the container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL_NAME=qwen2.5:3b

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Server
HOST=0.0.0.0
PORT=8000

# NOTE: Qdrant's index and the embedding-model cache live on Docker *named
# volumes* (system disk), NOT on the external drive, because exFAT/NTFS are not
# safe for a live database (no file locking / mmap / symlinks).
